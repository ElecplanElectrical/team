# Copy to .env and fill in. See docs/elecplan-build-spec.md §6 for production (Railway).

# --- Database (Phase 1) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/elecplan?schema=public"

# --- Auth.js / NextAuth (Phase 1) ---
AUTH_SECRET="replace-me"
AUTH_TRUST_HOST=true
NEXTAUTH_URL="http://localhost:3000"

# --- AI Assistant / whiteboard vision ---
# Server-side only. Add the real key as a Railway variable; never commit it.
# OPENAI_API_KEY=
# Optional model override. Must support image input + Responses API structured output.
# OPENAI_VISION_MODEL=gpt-5.4-mini

# --- Seed accounts ---
# SEED_PASSWORD=

# --- Xero (Phase 2) ---
# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=
# XERO_REDIRECT_URI=
# XERO_TOKEN_ENCRYPTION_KEY=

# --- SMS: ClickSend or Twilio (Phase 4) ---
# CLICKSEND_USERNAME=
# CLICKSEND_API_KEY=

# --- Private file storage: Cloudflare R2 / AWS S3 compatible (Phase 4) ---
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_ENDPOINT=
# S3_REGION=auto
