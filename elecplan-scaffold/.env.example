# Copy to .env and fill in. See docs/elecplan-build-spec.md §6 for production (Railway).

# --- Database (Phase 1) ---
# Local dev: matches docker-compose.yml. Production: Railway Postgres connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/elecplan?schema=public"

# --- Auth.js / NextAuth (Phase 1) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me"
AUTH_TRUST_HOST=true
# Local dev uses http://localhost:3000. In production (Railway) set this to the
# real portal URL, e.g. https://team.elecplan.com.au
NEXTAUTH_URL="http://localhost:3000"

# --- Seed accounts ---
# Password used for accounts created by `pnpm db:seed`. Leave unset locally
# (defaults to password123). REQUIRED in any internet-reachable deploy — set a
# strong value in Railway before seeding. See docs/DEPLOY-railway.md.
# SEED_PASSWORD=

# --- Xero (Phase 2 — add when wiring the integration) ---
# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=

# --- SMS: ClickSend or Twilio (Phase 4) ---
# CLICKSEND_USERNAME=
# CLICKSEND_API_KEY=

# --- File storage: Cloudflare R2 / AWS S3 (Phase 4) ---
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=
# S3_ENDPOINT=
