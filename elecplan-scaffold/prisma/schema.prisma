// Elecplan Portal — Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SUPERVISOR
  EMPLOYEE
}

enum JobStatus {
  QUOTED
  SCHEDULED
  IN_PROGRESS
  COMPLETE
  INVOICED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
}

enum InvoiceStatus {
  UNPAID
  PAID
  OVERDUE
}

enum LeadStage {
  NEW
  QUOTED
  WON
  LOST
}

enum SmsStatus {
  SENT
  CONFIRMED
  DECLINED
  FAILED
}

enum CertStatus {
  ISSUED
  PENDING
  EXPIRING
}

enum InspectionStatus {
  PASSED
  SCHEDULED
  FAILED
}

enum TimesheetStatus {
  PENDING
  APPROVED
}

enum PasswordTokenType {
  INVITE
  RESET
}

enum ScanEnrichmentStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  phone         String?
  role          Role      @default(EMPLOYEE)
  passwordHash  String?
  active        Boolean   @default(true)
  licenseNumber String?
  licenseExpiry DateTime?
  createdAt     DateTime  @default(now())
  assignedJobs   Job[]        @relation("AssignedEmployee")
  crewJobs       Job[]        @relation("JobCrew")
  timesheets     Timesheet[]
  reminders      Reminder[]
  certificates   Certificate[]
  jobEvents      JobEvent[]
  passwordTokens PasswordToken[]
  kpis           EmployeeKpi[]
}

model PasswordToken {
  id        String            @id @default(cuid())
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String            @unique
  type      PasswordTokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime          @default(now())
  @@index([userId])
}

model Client {
  id           String   @id @default(cuid())
  name         String
  contactName  String?
  phone        String?
  email        String?
  address      String?
  billingNotes String?
  createdAt    DateTime @default(now())
  leads    Lead[]
  jobs     Job[]
  quotes   Quote[]
  invoices Invoice[]
  reviews  Review[]
}

model Lead {
  id          String    @id @default(cuid())
  client      Client    @relation(fields: [clientId], references: [id])
  clientId    String
  description String
  stage       LeadStage @default(NEW)
  value       Decimal
  source      String?
  createdAt   DateTime  @default(now())
}

model Job {
  id             String    @id @default(cuid())
  title          String
  client         Client    @relation(fields: [clientId], references: [id])
  clientId       String
  address        String
  status         JobStatus @default(SCHEDULED)
  assignedTo     User?     @relation("AssignedEmployee", fields: [assignedToId], references: [id])
  assignedToId   String?
  crew           User[]    @relation("JobCrew")
  scheduledStart DateTime?
  scheduledEnd   DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  events       JobEvent[]
  quotes       Quote[]
  invoices     Invoice[]
  certificates Certificate[]
  inspections  Inspection[]
  documents    Document[]
  photos       ProjectPhoto[]
  smsLogs      SmsLog[]
  tasks        JobTask[]
  materials    JobMaterial[]
}

model JobEvent {
  id           String   @id @default(cuid())
  job          Job?     @relation(fields: [jobId], references: [id])
  jobId        String?
  title        String?
  notes        String?
  type         String
  startsAt     DateTime
  endsAt       DateTime
  assignedTo   User?    @relation(fields: [assignedToId], references: [id])
  assignedToId String?
}

model Quote {
  id               String      @id @default(cuid())
  quoteNumber      String?     @unique
  job              Job?        @relation(fields: [jobId], references: [id])
  jobId             String?
  client           Client      @relation(fields: [clientId], references: [id])
  clientId         String
  subtotal         Decimal?
  gstAmount        Decimal?
  amount           Decimal
  status           QuoteStatus @default(DRAFT)
  xeroId           String?
  createdAt        DateTime    @default(now())
  lineItems        QuoteLineItem[]
  convertedInvoice Invoice?    @relation("ConvertedQuote")
}

model QuoteLineItem {
  id          String  @id @default(cuid())
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId     String
  description String
  quantity    Decimal
  unitPrice   Decimal
  lineTotal   Decimal
  gstRate     Decimal @default(0.10)
  @@index([quoteId])
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String?       @unique
  job           Job?          @relation(fields: [jobId], references: [id])
  jobId         String?
  client        Client?       @relation(fields: [clientId], references: [id])
  clientId      String?
  supplier      String?
  subtotal      Decimal?
  gstAmount     Decimal?
  amount        Decimal
  dueDate       DateTime
  status        InvoiceStatus @default(UNPAID)
  xeroId        String?
  createdAt     DateTime      @default(now())
  sourceQuote   Quote?        @relation("ConvertedQuote", fields: [sourceQuoteId], references: [id])
  sourceQuoteId String?       @unique
  lineItems     InvoiceLineItem[]
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId   String
  description String
  quantity    Decimal
  unitPrice   Decimal
  lineTotal   Decimal
  gstRate     Decimal @default(0.10)
  @@index([invoiceId])
}

model Certificate {
  id            String     @id @default(cuid())
  job           Job        @relation(fields: [jobId], references: [id])
  jobId         String
  certNumber    String     @unique
  type          String
  electrician   User       @relation(fields: [electricianId], references: [id])
  electricianId String
  issuedDate    DateTime?
  status        CertStatus @default(PENDING)
}

model Inspection {
  id     String           @id @default(cuid())
  job    Job              @relation(fields: [jobId], references: [id])
  jobId  String
  type   String
  date   DateTime
  status InspectionStatus @default(SCHEDULED)
}

model Timesheet {
  id        String          @id @default(cuid())
  user      User            @relation(fields: [userId], references: [id])
  userId    String
  weekStart DateTime
  hours     Decimal
  status    TimesheetStatus @default(PENDING)
  createdAt DateTime        @default(now())
}

model Document {
  id         String   @id @default(cuid())
  name       String
  url        String
  storageKey String?
  mimeType   String?
  sizeBytes  Int?
  kind       String?
  job        Job?     @relation(fields: [jobId], references: [id])
  jobId      String?
  createdAt  DateTime @default(now())
}

model Reminder {
  id        String   @id @default(cuid())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  title     String
  dueAt     DateTime
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Review {
  id        String   @id @default(cuid())
  client    Client?  @relation(fields: [clientId], references: [id])
  clientId  String?
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  address     String?
  createdAt   DateTime @default(now())
  photos      ProjectPhoto[]
}

model ProjectPhoto {
  id         String   @id @default(cuid())
  project    Project? @relation(fields: [projectId], references: [id])
  projectId  String?
  job        Job?     @relation(fields: [jobId], references: [id])
  jobId      String?
  url        String
  storageKey String?
  mimeType   String?
  sizeBytes  Int?
  createdAt  DateTime @default(now())
}

model SmsLog {
  id         String    @id @default(cuid())
  job        Job       @relation(fields: [jobId], references: [id])
  jobId      String
  to         String
  message    String
  providerId String?
  status     SmsStatus @default(SENT)
  createdAt  DateTime  @default(now())
}

model QuoteLine {
  id          String   @id @default(cuid())
  description String
  quantity    Decimal
  unitPrice   Decimal
  createdAt   DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorName  String?
  actorEmail String?
  actorRole  String?
  action     String
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())
  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
}

model RateLimitBucket {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime
  updatedAt   DateTime @updatedAt
}

model Equipment {
  id             String   @id @default(cuid())
  name           String
  category       String?
  make           String?
  model          String?
  serialNumber   String?
  assetNumber    String?  @unique
  quantity       Int      @default(1)
  status         String   @default("AVAILABLE")
  assignedTo     String?
  location       String?
  purchaseDate   DateTime?
  purchasePrice  Decimal?
  serviceDue     DateTime?
  notes          String?
  photoUrl       String?
  photoStorageKey String?
  photoMimeType  String?
  photoSizeBytes Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Material {
  id              String   @id @default(cuid())
  name            String
  category        String?
  brand           String?
  model            String?
  sku             String?
  barcode         String?
  supplier        String?
  supplierSku     String?
  unit            String?
  stockOnHand     Decimal  @default(0)
  reorderPoint    Decimal?
  unitCost        Decimal?
  notes           String?
  photoUrl        String?
  photoStorageKey String?
  photoMimeType   String?
  photoSizeBytes  Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model EmployeeKpi {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  weekStart    DateTime
  jobsComplete Int      @default(0)
  hoursWorked  Decimal  @default(0)
  reworkCount  Int      @default(0)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@unique([userId, weekStart])
  @@index([weekStart])
}

model TeamMessage {
  id        String   @id @default(cuid())
  userId    String
  name      String
  role      Role
  body      String
  createdAt DateTime @default(now())
  reads     TeamMessageRead[]
  @@index([createdAt])
}

model TeamMessageRead {
  id        String      @id @default(cuid())
  message   TeamMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  messageId String
  userId    String
  readAt    DateTime    @default(now())
  @@unique([messageId, userId])
  @@index([userId, readAt])
}

model WeeklyGoal {
  id        String   @id @default(cuid())
  weekStart DateTime @unique
  target    Decimal  @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ScanEnrichmentQueue {
  id          String               @id @default(cuid())
  materialId  String
  barcode     String?
  photoUrl    String?
  status      ScanEnrichmentStatus @default(PENDING)
  attempts    Int                  @default(0)
  lastError   String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  @@index([status, createdAt])
}

model JobTask {
  id        String   @id @default(cuid())
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId     String
  title     String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([jobId])
}

model JobMaterial {
  id         String   @id @default(cuid())
  job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId      String
  materialId String
  name       String
  quantity   Decimal  @default(1)
  unit       String?
  createdAt  DateTime @default(now())
  @@index([jobId])
}
