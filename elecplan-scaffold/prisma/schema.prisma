// Elecplan Portal — Database Schema
// This is a starting point for Claude Code to build from, generated from the
// design work in elecplan-build-spec.md. Adjust field types/relations as the
// real build progresses — this covers the entities behind every screen we designed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SUPERVISOR
  EMPLOYEE
}

enum JobStatus {
  QUOTED
  SCHEDULED
  IN_PROGRESS
  COMPLETE
  INVOICED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
}

enum InvoiceStatus {
  UNPAID
  PAID
  OVERDUE
}

enum LeadStage {
  NEW
  QUOTED
  WON
  LOST
}

enum SmsStatus {
  SENT
  CONFIRMED
  DECLINED
  FAILED
}

enum CertStatus {
  ISSUED
  PENDING
  EXPIRING
}

enum InspectionStatus {
  PASSED
  SCHEDULED
  FAILED
}

enum TimesheetStatus {
  PENDING
  APPROVED
}

enum PasswordTokenType {
  INVITE
  RESET
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  phone         String?
  role          Role      @default(EMPLOYEE)
  passwordHash  String?
  active        Boolean   @default(true)
  licenseNumber String?
  licenseExpiry DateTime?
  createdAt     DateTime  @default(now())

  assignedJobs   Job[]        @relation("AssignedEmployee")
  timesheets     Timesheet[]
  reminders      Reminder[]
  certificates   Certificate[]
  jobEvents      JobEvent[]
  passwordTokens PasswordToken[]
}

model PasswordToken {
  id        String            @id @default(cuid())
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String            @unique
  type      PasswordTokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime          @default(now())

  @@index([userId])
}

model Client {
  id           String   @id @default(cuid())
  name         String
  contactName  String?
  phone        String?
  email        String?
  address      String?
  billingNotes String?
  createdAt    DateTime @default(now())

  leads    Lead[]
  jobs     Job[]
  quotes   Quote[]
  invoices Invoice[]
  reviews  Review[]
}

model Lead {
  id          String    @id @default(cuid())
  client      Client    @relation(fields: [clientId], references: [id])
  clientId    String
  description String
  stage       LeadStage @default(NEW)
  value       Decimal
  source      String?
  createdAt   DateTime  @default(now())
}

model Job {
  id             String    @id @default(cuid())
  title          String
  client         Client    @relation(fields: [clientId], references: [id])
  clientId       String
  address        String
  status         JobStatus @default(SCHEDULED)
  assignedTo     User?     @relation("AssignedEmployee", fields: [assignedToId], references: [id])
  assignedToId   String?
  scheduledStart DateTime?
  scheduledEnd   DateTime?
  notes          String?
  createdAt      DateTime  @default(now())

  events       JobEvent[]
  quotes       Quote[]
  invoices     Invoice[]
  certificates Certificate[]
  inspections  Inspection[]
  documents    Document[]
  photos       ProjectPhoto[]
  smsLogs      SmsLog[]
}

model JobEvent {
  id           String   @id @default(cuid())
  job          Job?     @relation(fields: [jobId], references: [id])
  jobId        String?
  title        String?
  type         String
  startsAt     DateTime
  endsAt       DateTime
  assignedTo   User?    @relation(fields: [assignedToId], references: [id])
  assignedToId String?
}

model Quote {
  id               String      @id @default(cuid())
  quoteNumber      String?     @unique
  job              Job?        @relation(fields: [jobId], references: [id])
  jobId            String?
  client           Client      @relation(fields: [clientId], references: [id])
  clientId         String
  subtotal         Decimal?
  gstAmount        Decimal?
  amount           Decimal
  status           QuoteStatus @default(DRAFT)
  xeroId           String?
  createdAt        DateTime    @default(now())
  lineItems        QuoteLineItem[]
  convertedInvoice Invoice?    @relation("ConvertedQuote")
}

model QuoteLineItem {
  id          String  @id @default(cuid())
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId     String
  description String
  quantity    Decimal
  unitPrice   Decimal
  lineTotal   Decimal
  gstRate     Decimal @default(0.10)

  @@index([quoteId])
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String?       @unique
  job           Job?          @relation(fields: [jobId], references: [id])
  jobId         String?
  client        Client?       @relation(fields: [clientId], references: [id])
  clientId      String?
  supplier      String?
  subtotal      Decimal?
  gstAmount     Decimal?
  amount        Decimal
  dueDate       DateTime
  status        InvoiceStatus @default(UNPAID)
  xeroId        String?
  createdAt     DateTime      @default(now())
  sourceQuote   Quote?        @relation("ConvertedQuote", fields: [sourceQuoteId], references: [id])
  sourceQuoteId String?       @unique
  lineItems     InvoiceLineItem[]
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId   String
  description String
  quantity    Decimal
  unitPrice   Decimal
  lineTotal   Decimal
  gstRate     Decimal @default(0.10)

  @@index([invoiceId])
}

model Certificate {
  id            String     @id @default(cuid())
  job           Job        @relation(fields: [jobId], references: [id])
  jobId         String
  certNumber    String     @unique
  type          String
  electrician   User       @relation(fields: [electricianId], references: [id])
  electricianId String
  issuedDate    DateTime?
  status        CertStatus @default(PENDING)
}

model Inspection {
  id     String           @id @default(cuid())
  job    Job              @relation(fields: [jobId], references: [id])
  jobId  String
  type   String
  date   DateTime
  status InspectionStatus @default(SCHEDULED)
}

model StockItem {
  id       String @id @default(cuid())
  name     String
  unit     String
  onHand   Int
  parLevel Int
  supplier String?
}

model Timesheet {
  id     String          @id @default(cuid())
  user   User            @relation(fields: [userId], references: [id])
  userId String
  date   DateTime
  hours  Decimal
  status TimesheetStatus @default(PENDING)
}

model Document {
  id           String   @id @default(cuid())
  job          Job?     @relation(fields: [jobId], references: [id])
  jobId        String?
  name         String
  fileUrl      String
  type         String
  storageKey   String?  @unique
  originalName String?
  contentType  String?
  sizeBytes    Int?
  uploadedAt   DateTime @default(now())
}

model ProjectPhoto {
  id           String   @id @default(cuid())
  job          Job      @relation(fields: [jobId], references: [id])
  jobId        String
  fileUrl      String
  storageKey   String?  @unique
  originalName String?
  contentType  String?
  sizeBytes    Int?
  uploadedAt   DateTime @default(now())
}

model Reminder {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  title     String
  dueDate   DateTime?
  tag       String?
  completed Boolean  @default(false)
}

model Review {
  id        String   @id @default(cuid())
  client    Client   @relation(fields: [clientId], references: [id])
  clientId  String
  rating    Int
  text      String?
  source    String?
  createdAt DateTime @default(now())
}

model SmsLog {
  id          String    @id @default(cuid())
  job         Job       @relation(fields: [jobId], references: [id])
  jobId       String
  phoneNumber String
  message     String
  status      SmsStatus @default(SENT)
  providerId  String?
  createdAt   DateTime  @default(now())
}

model ReelIdea {
  id           String    @id @default(cuid())
  title        String
  hook         String?
  platform     String
  status       String    @default("IDEA")
  scheduledAt  DateTime?
  publishedUrl String?
  notes        String?
  createdAt    DateTime  @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorEmail String?
  action     String
  entityType String
  entityId   String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
}

model RateLimitBucket {
  key         String   @id
  count       Int
  windowStart DateTime
  expiresAt   DateTime

  @@index([expiresAt])
}
